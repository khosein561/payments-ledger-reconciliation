# Copy to .env and fill in. NEVER commit .env.
# NEVER use live Stripe keys here: this project is TEST MODE ONLY.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=change_me

# Or set one URL instead of the five lines above:
# LEDGER_DATABASE_URL=postgresql+psycopg2://ledger:change_me@localhost:5432/ledger

# Stripe TEST mode (dashboard -> Developers; or `stripe listen` prints the whsec_ secret)
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Key for tokenizing personal data. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
PII_TOKEN_KEY=change_me

# Optional: incoming-webhook URL (Slack/Discord/Teams style) for alerts
ALERT_WEBHOOK_URL=
